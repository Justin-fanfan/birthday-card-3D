/*
    掼蛋牌架主体 V4

    已包含：
    1. 三层阶梯牌架
    2. 三排后仰扑克牌槽
    3. 中央红桃A展示牌槽
    4. 左右计分器模块安装凹槽
    5. 左右计分器 M3 中轴孔

    后续：
    - 计分轮单独打印
    - 计分器前盖单独打印

    X = 左右
    Y = 前后
    Z = 上下
*/

$fn = 64;


// ============================================================
// 1. 总体尺寸
// ============================================================

rack_w = 210;
rack_d = 85;

base_t = 5;


// ============================================================
// 2. 前挡板
// ============================================================

front_d = 22;
front_h = 30;


// ============================================================
// 3. 三层牌架
// ============================================================

tier_d = 18;

tier1_y = 24;
tier1_h = 34;

tier2_y = 45;
tier2_h = 42;

tier3_y = 66;
tier3_h = 50;


// ============================================================
// 4. 普通扑克牌槽
// ============================================================

card_slot_len = 192;

card_slot_w = 2.2;

card_slot_depth = 10;

card_lean = 12;


// ============================================================
// 5. 红桃A展示槽
// ============================================================

display_slot_len = 62;

// 红桃A预计 3.2mm 厚
display_slot_w = 3.7;

display_slot_depth = 9;

display_lean = 8;

display_y = 11;


// ============================================================
// 6. 计分器模块安装位
// ============================================================

// 每个计分模块占据的宽度
score_w = 62;

// 高度
score_h = 24;

// 凹进去多少
score_recess_d = 2.2;

// 距离左右边缘
score_margin_x = 7;

// 安装位距离底部
score_z = 3;


// ------------------------------------------------------------
// M3 中轴孔
// ------------------------------------------------------------

// 实际 M3 螺丝不要做3.0，留公差
score_axle_d = 3.4;

// 中轴在模块中的横向位置
// 我们以后设计为：
// 左边数字窗口 + 右边旋转拨轮
score_axle_offset_x = 43;

// 中轴高度
score_axle_z =
    score_z + score_h / 2;


// ============================================================
// 7. 调试
// ============================================================

show_cutters = false;


// ============================================================
// 基础底板
// ============================================================

module base()
{
    cube([
        rack_w,
        rack_d,
        base_t
    ]);
}


// ============================================================
// 前挡板
// ============================================================

module front_panel()
{
    cube([
        rack_w,
        front_d,
        front_h
    ]);
}


// ============================================================
// 单层牌架
// ============================================================

module tier(y, h)
{
    translate([
        0,
        y,
        0
    ])

    cube([
        rack_w,
        tier_d,
        h
    ]);
}


// ============================================================
// 整个主体
// ============================================================

module rack_body()
{
    union()
    {
        base();

        front_panel();

        tier(
            tier1_y,
            tier1_h
        );

        tier(
            tier2_y,
            tier2_h
        );

        tier(
            tier3_y,
            tier3_h
        );
    }
}


// ============================================================
// 通用斜槽切割器
// ============================================================

module slot_cutter(
    y,
    z_top,
    len,
    width,
    depth,
    lean
)
{
    translate([
        rack_w / 2,
        y,
        z_top - depth / 2 + 1
    ])

    rotate([
        -lean,
        0,
        0
    ])

    cube([
        len,
        width,
        depth + 6
    ], center = true);
}


// ============================================================
// 三排扑克牌槽
// ============================================================

module card_slot_cutters()
{
    slot_cutter(
        tier1_y + tier_d/2,
        tier1_h,
        card_slot_len,
        card_slot_w,
        card_slot_depth,
        card_lean
    );

    slot_cutter(
        tier2_y + tier_d/2,
        tier2_h,
        card_slot_len,
        card_slot_w,
        card_slot_depth,
        card_lean
    );

    slot_cutter(
        tier3_y + tier_d/2,
        tier3_h,
        card_slot_len,
        card_slot_w,
        card_slot_depth,
        card_lean
    );
}


// ============================================================
// 红桃A展示槽
// ============================================================

module display_slot_cutter()
{
    slot_cutter(
        display_y,
        front_h,
        display_slot_len,
        display_slot_w,
        display_slot_depth,
        display_lean
    );
}


// ============================================================
// 计分器安装凹槽
// ============================================================

module score_recesses()
{
    // --------------------
    // 左侧 A组
    // --------------------

    translate([
        score_margin_x,
        -0.1,
        score_z
    ])

    cube([
        score_w,
        score_recess_d + 0.2,
        score_h
    ]);


    // --------------------
    // 右侧 B组
    // --------------------

    translate([
        rack_w
            - score_margin_x
            - score_w,

        -0.1,
        score_z
    ])

    cube([
        score_w,
        score_recess_d + 0.2,
        score_h
    ]);
}


// ============================================================
// 一个沿 Y 方向的 M3 孔
// ============================================================

module y_hole(
    x,
    z,
    diameter
)
{
    translate([
        x,
        front_d + 1,
        z
    ])

    rotate([
        90,
        0,
        0
    ])

    cylinder(
        h = front_d + 2,
        d = diameter
    );
}


// ============================================================
// 左右计分器中轴孔
// ============================================================

module score_axle_holes()
{
    // 左侧
    left_x =
        score_margin_x
        + score_axle_offset_x;

    y_hole(
        left_x,
        score_axle_z,
        score_axle_d
    );


    // 右侧
    right_x =
        rack_w
        - score_margin_x
        - score_w
        + score_axle_offset_x;

    y_hole(
        right_x,
        score_axle_z,
        score_axle_d
    );
}


// ============================================================
// 最终牌架主体
// ============================================================

difference()
{
    rack_body();

    // 三排普通牌
    card_slot_cutters();

    // 红桃A
    display_slot_cutter();

    // 左右计分模块凹槽
    score_recesses();

    // 两个M3轴孔
    score_axle_holes();
}


// ============================================================
// 调试
// ============================================================

if(show_cutters)
{
    #card_slot_cutters();

    #display_slot_cutter();

    #score_recesses();

    #score_axle_holes();
}